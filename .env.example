# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost/volunteer_match_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_NAME=volunteer_match_dev
DATABASE_POOL_SIZE=10

# Phoenix Configuration
SECRET_KEY_BASE=your-secret-key-base-min-64-chars-generate-with-mix-phx-gen-secret
PHX_HOST=localhost
PHX_PORT=4000
ECTO_IPV6=false

# Guardian JWT
GUARDIAN_SECRET_KEY=your-guardian-secret-key-generate-with-mix-guardian-gen-secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@volunteermatch.org

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET=volunteer-match-uploads
AWS_REGION=us-east-1

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-url

# Maps API
MAPBOX_TOKEN=your-mapbox-access-token

# Application Settings
APP_NAME=VolunteerMatch
APP_VERSION=1.0.0
DEFAULT_LOCALE=en
TIMEZONE=UTC

# Feature Flags
ENABLE_REGISTRATIONS=true
ENABLE_MESSAGING=true
REQUIRE_NGO_VERIFICATION=false
